<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.dj.nas-link</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>REPO_ROOT/scripts/update-nas-link.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>NAS_VOLUME</key>
        <string>buckles</string>
    </dict>
    <key>WatchPaths</key>
    <array>
        <string>/Volumes</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/dj-tools/nas-link-launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/dj-tools/nas-link-launchd.err</string>
</dict>
</plist>
